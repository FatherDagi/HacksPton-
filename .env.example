# Copy to .env.local and fill in. Never commit real values.

# Gemini (Google AI Studio -> Get API key). Server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Supabase (Phase 3) - Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Sheets export (Phase 6) - service account JSON fields
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Sponsor data (Phase 5)
NEXT_PUBLIC_MATTERPORT_MODEL_ID=
