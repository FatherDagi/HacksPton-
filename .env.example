# Copy to .env.local and fill in. Never commit real values.

# Gemini (Google AI Studio -> Get API key). Server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Supabase (Phase 3) - Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Sheets export (Phase 6) - service account JSON fields
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Sponsor data (Phase 5)
NEXT_PUBLIC_MATTERPORT_MODEL_ID=

# Station desk bridge (station-desk/ Python service).
# Local: leave blank → http://127.0.0.1:8787 (npm run desk).
# Vercel: do NOT set — injected by the app → station-desk service binding.
STATION_DESK_URL=

# Twilio phone line for the station desk (npm run desk reads these from .env.local)
# Public https address of the desk, no trailing slash.
# Local tunnel example: https://xyz.ngrok.app
# Vercel: https://<your-deployment>.vercel.app/desk
PUBLIC_BASE_URL=
# Twilio Console -> Account -> API keys & tokens -> Auth Token (lets the desk reject fake webhooks)
TWILIO_AUTH_TOKEN=
# Optional: a phone that rings so a person can talk to the caller, e.g. +15551234567
STATION_DESK_NUMBER=
# Phone calls: default connects caller and station directly (real voices) while the desk listens.
# Set to 1 for the AI interpreter instead (each side hears a spoken translation, ~3 s delay).
DESK_INTERPRETER=
