# From Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Leave blank to use gemini-3.5-transcribe-live for the live transcript.
GEMINI_LIVE_MODEL=

# Optional. Used for keyword cleanup and for recordings that are not wav or pcm.
GEMINI_MODEL=

# Public https address of this desk, with no trailing path.
# Example: https://station-desk.ngrok.app
# Twilio calls this address. The browser console stays on this computer.
PUBLIC_BASE_URL=

# Optional. Twilio signs webhooks with this token.
TWILIO_AUTH_TOKEN=

# Optional. Where the station phone should ring while the call is transcribed.
# Example: +15551234567
STATION_DESK_NUMBER=
